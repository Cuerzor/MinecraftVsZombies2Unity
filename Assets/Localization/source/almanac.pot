msgid ""
"“爷爷，这个上面有个熔炉的矿车是什么啊？”\n"
"“孩子，坐下，让我给你讲个故事。”\n"
"“那是我年轻的时候的故事……”"
msgstr ""

#. Name for misc mvz2:gargoyle_statue
#: Almanac meta file
