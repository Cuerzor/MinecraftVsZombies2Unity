msgstr ""

#. Header for enemies mvz2:iron_helmetted_zombie
#: Almanac meta file
msgctxt "enemies.description"
msgid "铁盔僵尸的铁盔给他提供了极高的防护。"
msgstr ""

#. Flavor for enemies mvz2:iron_helmetted_zombie
#: Almanac meta file
msgctxt "enemies.description"
msgid "戴着铁盔的僵尸好像是生前是个战士一样，其实不是，他只是比较有智商而已。"
msgstr ""

#. Header for enemies mvz2:diamond_helmetted_zombie
#: Almanac meta file
msgctxt "enemies.description"
msgid "钻石盔僵尸的钻石盔给他提供了最高的防护。"
msgstr ""

#. Flavor for enemies mvz2:diamond_helmetted_zombie
#: Almanac meta file
msgctxt "enemies.description"
msgid "不好意思，因为他之前在挖钻石，所以迟到了！"
msgstr ""

#. Header for enemies mvz2:skeleton
#: Almanac meta file
msgctxt "enemies.description"
