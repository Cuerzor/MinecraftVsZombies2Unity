<views>
    <view id="default" priority="0">
        <bright>mvz2:mainmenu/view/default[0]</bright>
        <dark>mvz2:mainmenu/view/default[1]</dark>
    </view>
    <view id="halloween" priority="100">
        <bright>mvz2:mainmenu/view/halloween[0]</bright>
        <dark>mvz2:mainmenu/view/halloween[1]</dark>
        <conditions>
            <condition required="mvz2:level.prologue" />
        </conditions>
    </view>
    <view id="dream" priority="200">
        <bright>mvz2:mainmenu/view/dream[0]</bright>
        <dark>mvz2:mainmenu/view/dream[1]</dark>
        <conditions>
            <condition required="mvz2:entered_dream" requiredNot="mvz2:dream_is_nightmare" />
        </conditions>
    </view>
    <view id="nightmare" priority="200">
        <bright>mvz2:mainmenu/view/nightmare[0]</bright>
        <dark>mvz2:mainmenu/view/nightmare[1]</dark>
        <conditions>
            <condition required="mvz2:entered_dream mvz2:dream_is_nightmare" />
        </conditions>
    </view>
    <view id="castle" priority="300">
        <bright>mvz2:mainmenu/view/castle[0]</bright>
        <dark>mvz2:mainmenu/view/castle[1]</dark>
        <conditions>
            <condition required="mvz2:entered_castle" />
        </conditions>
    </view>
    <view id="mausoleum" priority="400">
        <bright>mvz2:mainmenu/view/mausoleum[0]</bright>
        <dark>mvz2:mainmenu/view/mausoleum[1]</dark>
        <conditions>
            <condition required="mvz2:entered_mausoleum" />
        </conditions>
    </view>
    <view id="ship" priority="500">
        <bright>mvz2:mainmenu/view/ship[0]</bright>
        <dark>mvz2:mainmenu/view/ship[1]</dark>
        <conditions>
            <condition required="mvz2:entered_ship" />
        </conditions>
    </view>
    <view id="palace" priority="600">
        <bright>mvz2:mainmenu/view/palace[0]</bright>
        <dark>mvz2:mainmenu/view/palace[1]</dark>
        <conditions>
            <condition required="mvz2:entered_palace" />
        </conditions>
    </view>
</views>